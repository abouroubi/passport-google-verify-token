{
  "name": "passport-google-verify-token",
  "version": "3.0.5",
  "description": "Google Token strategy for Passport, let's you validate the user token server side, usefull for mobile app Google authentication for example. The validation is done by the official Google Auth library for NodeJs.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "test": "vitest run",
    "cover": "vitest run --coverage",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write \"**/*.{ts,mts,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,mts,mjs,json}\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "passport",
    "google",
    "token",
    "authentication",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abouroubi/passport-google-verify-token.git"
  },
  "author": "Abdou BOUROUBI",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "google-auth-library": "^10.2.1",
    "passport-strategy": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/passport-strategy": "^0.2.36",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
