{
  "name": "passport-google-verify-token",
  "version": "3.0.5",
  "description": "Passport strategy that verifies Google id tokens and access tokens server side with the official Google Auth Library, for mobile apps, SPAs and Google Identity Services.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "clean": "rimraf lib",
    "test": "vitest run",
    "cover": "vitest run --coverage",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write \"**/*.{ts,mts,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,mts,mjs,json}\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "passport",
    "google",
    "token",
    "authentication",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abouroubi/passport-google-verify-token.git"
  },
  "author": "Abdou BOUROUBI",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@types/passport-strategy": "^0.2.38",
    "gaxios": "^8.3.3",
    "google-auth-library": "^11.3.4",
    "passport-strategy": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "msw": "^3.0.7",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
